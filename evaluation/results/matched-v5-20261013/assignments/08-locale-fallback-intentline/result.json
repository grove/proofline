    "record": "intentline.advisory-input",
    "requirements": [
      {
        "basis": "request",
        "boundaries": [
          "Case-sensitive lookup",
          "Empty translation is found",
          "A requested parent precedes the next requested locale",
          "Default is never truncated",
          "Repeated and leading/trailing hyphens remain governed only by string truncation"
        ],
        "evidence_gap_reasons": [],
        "id": "R1",
        "oracle": "For fr-CA with a in fr-CA, b in fr and c in en, keys b,a,c,x,a yield FR,CA,EN,null,CA; a present empty string suppresses fallback.",
        "plan_state": "planned",
        "planned_evidence": "Unit tests with literal expected translations and counterexamples for per-key lookup, ordering, casing, empty values and default truncation.",
        "seam": "app.process(payload)",
        "source_refs": [
          {
            "line_end": 8,
            "line_start": 1,
            "quote": "Implement per-key translations for {\"catalog\": {locale: {key: text}},\n\"locales\": [locale, ...], \"keys\": [key, ...], \"default\": locale}.\nLocale names and keys are nonempty strings; translations are strings, including\nempty strings. For EACH key, try requested locales in order, trying each exact\nlocale then repeatedly removing its last hyphen subtag. Only if no requested\nlocale contains that key, try the exact default locale (no default truncation).\nReturn {\"texts\": [translation_or_null, ...]} in keys order, retaining duplicates.\nMatching is case sensitive; an empty translation is a found value, not missing.",
            "source_id": "S1"
