    "export_format": "json",
    "export_manifest_sha256": "1362e95c3bf81a81e70566f03f2fa8cd7d14abe25f0e8c4df954da6933f1db59",
    "external_caller_approval": "not_supplied_or_authenticated",
    "intended_outcome": "Expose a validated, non-mutating FIFO cache with stable-position updates, ordered evictions and consistent process, service, batch and CLI behavior.",
    "out_of_scope": [],
    "record": "intentline.advisory-input",
    "requirements": [
      {
        "basis": "request",
        "boundaries": [
          "Missing fields, non-object records, non-list events, negative/bool capacities and empty/non-string IDs are invalid.",
          "Null and all JSON value types are valid; extra object keys are allowed and ignored."
        ],
        "evidence_gap_reasons": [],
        "id": "R1",
        "oracle": "Explicit valid/invalid fixtures establish acceptance; null succeeds, missing value fails.",
        "plan_state": "planned",
        "planned_evidence": "tests/test_fifo.py validation cases",
        "seam": "app.process and service.handle",
        "source_refs": [
          {
            "line_end": 9,
            "line_start": 1,
            "quote": "Implement a FIFO record cache for {\"capacity\": integer >= 0,\n\"events\": [{\"id\": nonempty_string, \"value\": any_JSON_value}, ...]}.\nEvery event must contain both id and value. Booleans are invalid capacities.\nUpdate an existing ID in its original insertion position, without promoting it.\nWhen inserting a new ID would exceed capacity, evict the oldest resident ID.\nCapacity zero immediately evicts EVERY event. Return {\"items\": [final records\nin FIFO order], \"evicted\": [IDs in eviction order, retaining repetitions]}.\nOutput records contain only id and value; extra input keys are ignored.\nReject malformed records/containers with ValueError. Input values may be null.",
